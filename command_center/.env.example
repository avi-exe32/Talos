# =============================================================================
#  command_center/.env.example
#  Copy this to .env and fill in real values.
#  NEVER commit .env — it is blocked by .gitignore.
# =============================================================================

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to "true" to use static fixture responses (no Gemini API calls, no DB reads)
# Set to "false" for full live mode
DEMO_MODE=false

# ── Database ──────────────────────────────────────────────────────────────────
# Cloud SQL instance connection name (format: project:region:instance)
INSTANCE_CONNECTION_NAME=talos-496511:asia-south1:talos-base

DB_NAME=talos_app
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Cloud SQL Public IP (used ONLY for local dev when USE_CONNECTOR=false)
DB_HOST=35.234.215.116
DB_PORT=5432

# Set to "true" on Cloud Run, "false" for local dev
USE_CONNECTOR=false

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── VSP Endpoint (set after Phase 2 deployment) ───────────────────────────────
VSP_BASE_URL=https://talos-vsp-xxxxxxxx-el.a.run.app
